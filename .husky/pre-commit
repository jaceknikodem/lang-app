#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint-staged (formats code, doesn't block on linting errors)
echo "📝 Formatting code..."
npx lint-staged || {
  echo "⚠️  Formatting issues detected, but not blocking commit."
  exit 0
}

echo "✅ Pre-commit checks passed!"
