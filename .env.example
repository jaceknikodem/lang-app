# Environment variables for secrets and sensitive configuration
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and should not be committed

# Gemini API Key (if using Gemini LLM provider)
# GEMINI_API_KEY=your_gemini_api_key_here

# Other secrets can be added here as needed
# Note: Most configuration should be in config.toml
# Use .env only for secrets that should not be committed to version control
